# Copy to .env and review before using Compose. This file contains no secrets.
COMPOSE_PROJECT_NAME=nextcloud
TZ=America/New_York

# Pin Nextcloud to a supported major and patch. Review release notes before bumping.
NEXTCLOUD_VERSION=33.0.6-apache
POSTGRES_VERSION=17-alpine
REDIS_VERSION=8-alpine
GO_VOD_VERSION=latest

# Tailscale Serve access. Replace the example with this node's full DNS name:
# tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//'
NEXTCLOUD_HOSTNAME=pc.your-tailnet.ts.net
NEXTCLOUD_PORT=8080
NEXTCLOUD_BIND_ADDRESS=127.0.0.1
NEXTCLOUD_OVERWRITE_HOST=pc.your-tailnet.ts.net
NEXTCLOUD_OVERWRITE_PROTOCOL=https
NEXTCLOUD_OVERWRITE_CLI_URL=https://pc.your-tailnet.ts.net
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
NEXTCLOUD_ADMIN_USER=admin

# Keep live state beneath the repository by default; every path is gitignored.
NEXTCLOUD_DATA_LOCATION=./nextcloud
POSTGRES_DATA_LOCATION=./data/postgres
REDIS_DATA_LOCATION=./data/redis

# The Arc render-node GID on Ubuntu is commonly 991. Verify with:
# stat -c '%g' /dev/dri/renderD128
RENDER_GID=991

# PostgreSQL defaults sized conservatively for this 30 GiB / NVMe host.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_WORK_MEM=16MB

# Secret files are generated locally by scripts/prepare.sh and ignored by Git.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
NEXTCLOUD_ADMIN_PASSWORD_FILE=./secrets/nextcloud_admin_password
